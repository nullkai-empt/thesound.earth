    {"id": "kuroshio", "name": "North Pacific (Kuroshio)",
     "lat": [28, 40], "lon": [130, 160]},

    {"id": "east_australian", "name": "South Pacific (East Australian Current)",
     "lat": [-40, -25], "lon": [150, 170]},

    {"id": "brazil_malvinas", "name": "South Atlantic (Brazil-Malvinas)",
     "lat": [-50, -35], "lon": [300, 320]},

    {"id": "arabian_sea", "name": "Indian Ocean (Arabian Sea)",
     "lat": [5, 25], "lon": [50, 75]},

    {"id": "drake_acc", "name": "Southern Ocean (Drake Passage / ACC)",
     "lat": [-65, -55], "lon": [290, 310]},

    {"id": "nordic_seas", "name": "Arctic (Nordic Seas)",
     "lat": [62, 75], "lon": [-15, 20],
